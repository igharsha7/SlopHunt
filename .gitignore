# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local agent settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# hyperframes render artifacts
video/roast-video/renders/
video/roast-video/.producer/

# kokoro model cache
.cache/

# generated voiceover (regenerate with npm run video:voice)
video/roast-video/*.wav
video/roast-video/*.mp3

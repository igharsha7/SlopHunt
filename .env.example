# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase ---
# Project URL + publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role / secret key. SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Direct Postgres connection (migrations / drizzle-kit).
DATABASE_URL=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=

# --- Roast writers ---
# Grok is the primary script generator; Claude is the fallback; a
# deterministic composer runs when neither key is set.
XAI_API_KEY=
GROK_MODEL=grok-4
ANTHROPIC_API_KEY=

# --- Services ---
RENDERGATE_URL=
HYPERFRAMES_API_KEY=

# --- Auth / app ---
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mock modes (run the whole loop with zero external deps) ---
MOCK_VIDEO=true
MOCK_SCREENSHOTS=true

# --- Backend (cloudflared tunnel to the render machine) ---
NEXT_PUBLIC_BACKEND_URL=

# Public repo for the open-source links (must be PUBLIC or it 404s)
NEXT_PUBLIC_REPO_URL=

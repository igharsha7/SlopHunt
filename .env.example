# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase ---
# Project URL + publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role / secret key. SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Direct Postgres connection (migrations / drizzle-kit).
DATABASE_URL=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Services ---
RENDERGATE_URL=
HYPERFRAMES_API_KEY=

# --- Auth / app ---
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mock modes (run the whole loop with zero external deps) ---
MOCK_VIDEO=true
MOCK_SCREENSHOTS=true
